@model List<Empleado>
<h1 style="color:yellow">Session Empleados List V4</h1>

<p>
    <a asp-controller="Empleados" asp-action="EmpleadosAlmacenadosV4" class="btn btn-info">Empleados Almacenados V4</a>
</p>

<h4 style="color:yellow">@ViewData["MENSAJE"]</h4>

<ul class="list-group">
    @foreach (Empleado empleado in Model)
    {
        <li class="list-group-item list-group-item-danger">
            @empleado.Apellido
            <a asp-controller="Empleados" asp-action="SessionEmpleadosV4" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
        </li>
    }
</ul>