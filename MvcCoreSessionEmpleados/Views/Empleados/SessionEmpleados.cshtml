@model List<Empleado>
<h1 style="color:blue">Session Empleados List</h1>

<p>
    <a asp-controller="Empleados" asp-action="EmpleadosAlmacenados" class="btn btn-info">Empleados Almacenados</a>
</p>

<h4>@ViewData["MENSAJE"]</h4>

<ul class="list-group">
    @foreach (Empleado empleado in Model)
    {
        <li class="list-group-item list-group-item-warning">
            @empleado.Apellido
            <a asp-controller="Empleados" asp-action="SessionEmpleados" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
        </li>
    }
</ul>