@model List<Empleado>
<h1 style="color:green">Session Empleados List OK</h1>

<p>
    <a asp-controller="Empleados" asp-action="EmpleadosAlmacenadosOk" class="btn btn-info">Empleados Almacenados OK</a>
</p>

<h4 style="color:green">@ViewData["MENSAJE"]</h4>

<ul class="list-group">
    @foreach (Empleado empleado in Model)
    {
        <li class="list-group-item list-group-item-warning">
            @empleado.Apellido
            <a asp-controller="Empleados" asp-action="SessionEmpleadosOk" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
        </li>
    }
</ul>