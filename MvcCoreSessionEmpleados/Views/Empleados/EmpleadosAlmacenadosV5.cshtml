@model List<Empleado>

<h1 style="color:coral">Empleados Almacenados V5</h1>
<p>
    <a asp-controller="Empleados" asp-action="SessionEmpleadosV5">Volver a Session empleados V5</a>
</p>

@if(Context.Session.GetString("IDSEMPLEADOS") == null)
{
    <h2 style="color:green">No hay empleados almacenados en Session</h2>
}

@if (Model != null)
{
    <table class="table table-secondary">
        <thead>
            <tr>
                <th>IdEmpleado</th>
                <th>Apellido</th>
                <th>Oficio</th>
                <th>Salario</th>
                <th>IdDepartamento</th>
                <th>Accion</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdEmpleado</td>
                    <td>@item.Apellido</td>
                    <td>@item.Oficio</td>
                    <td>@item.Salario</td>
                    <td>@item.IdDepartamento</td>
                    <td>
                        <a asp-controller="Empleados" asp-action="EmpleadosAlmacenadosV5" asp-route-ideliminar="@item.IdEmpleado" class="btn btn-danger">Eliminar de Session</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}