@model List<Empleado>
@{
    // List<int> idsEmpleados = Context.Session.GetObject<List<int>>("IDSEMPLEADOS");
}

<h1 style="color:green">Empleados Almacenados OK</h1>
<p>
    <a asp-controller="Empleados" asp-action="SessionEmpleadosOk">Volver a Session empleados OK</a>
</p>

<h2 style="color:red">@ViewData["MENSAJE"]</h2>

@if (Model != null)
{
    <table class="table table-success">
        <thead>
            <tr>
                <th>IdEmpleado</th>
                <th>Apellido</th>
                <th>Oficio</th>
                <th>Salario</th>
                <th>IdDepartamento</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdEmpleado</td>
                    <td>@item.Apellido</td>
                    <td>@item.Oficio</td>
                    <td>@item.Salario</td>
                    <td>@item.IdDepartamento</td>
                </tr>
            }
        </tbody>
    </table>
}

