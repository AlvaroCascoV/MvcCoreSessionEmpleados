@*
@using Microsoft.Extensions.Caching.Memory 
@inject IMemoryCache memoryCache

//esto está en el viewImports *@ 
@model List<Empleado>
@{
    //NECESITAMOS SESSION EN LA VISTA PARA COMPROBAR SUS DATOS
    List<int> ids = Context.Session.GetObject<List<int>>("IDSEMPLEADOS");
    //recuperamos el memorycache
    List<Empleado> favoritos = memoryCache.Get<List<Empleado>>("FAVORITOS");
}

<h1 style="color:coral">Session Empleados List V5</h1>

@if(ids != null)
{
    <h4 style="background-color:green">Empleados Almacenados en Session: <b>@ids.Count</b></h4>
}
else
{
    <h4 style="background-color:green">Empleados Almacenados en Session: <b>0</b></h4>
}
@if(favoritos != null)
{
    <h4 style="background-color:coral">Empleados Favoritos: <b>@favoritos.Count</b></h4>
}
else
{
    <h4 style="background-color:coral">Empleados Favoritos: <b>0</b></h4>
}

<p>
    <a asp-controller="Empleados" asp-action="EmpleadosAlmacenadosV5" class="btn btn-info">Empleados Almacenados V5</a>
    <a asp-controller="Empleados" asp-action="EmpleadosFavoritos" class="btn btn-primary">Favoritos</a>
</p>

<h4 style="color:coral">@ViewData["MENSAJE"]</h4>

<ul class="list-group">
    @foreach (Empleado empleado in Model)
    {
        <li class="list-group-item list-group-item-danger">
            @empleado.Apellido
            
            @if(favoritos == null)
            {
                <a asp-controller="Empleados" asp-action="SessionEmpleadosV5" asp-route-idfavorito="@empleado.IdEmpleado" class="btn btn-primary">Favorito</a>
            }
            else
            {
                //DEBEMOS PREGUNTAR SI EXISTE EL EMPLEADO CON EL ID QUE TENEMOS ALMACENADO
                Empleado empFavorito = favoritos.Find(x => x.IdEmpleado == empleado.IdEmpleado);
                if (empFavorito != null)
                {
                    <img src="~/images/darkhorse.jpg" style="height:50px"/>
                }
                else
                {
                    <a asp-controller="Empleados" asp-action="SessionEmpleadosV5" asp-route-idfavorito="@empleado.IdEmpleado" class="btn btn-primary">Favorito</a>
                }
            }


            
            @* PREGUNTAMOS SI EXISTE EL EMPLEADO EN SESSION *@
            @if (ids == null)
            {
                <a asp-controller="Empleados" asp-action="SessionEmpleadosV5" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
            }
            else
            {
                //BUSCAMOS SI EL EMPLEADO QUE ESTAMOS RECORRIENDO ESTÁ EN LA LISTA
                if (ids.Contains(empleado.IdEmpleado))
                {
                    <img src="~/images/gtr3r.jpg" style="height:50px"/>
                }
                else
                {
                    <a asp-controller="Empleados" asp-action="SessionEmpleadosV5" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
                }
            }
        </li>
    }
</ul>