@model List<Empleado>

@{
    //NECESITAMOS SESSION EN LA VISTA PARA COMPROBAR SUS DATOS
    List<int> ids = Context.Session.GetObject<List<int>>("IDSEMPLEADOS");
}

<h1 style="color:coral">Session Empleados List V5</h1>

<p>
    <a asp-controller="Empleados" asp-action="EmpleadosAlmacenadosV5" class="btn btn-info">Empleados Almacenados V5</a>
</p>

<h4 style="color:coral">@ViewData["MENSAJE"]</h4>

<ul class="list-group">
    @foreach (Empleado empleado in Model)
    {
        <li class="list-group-item list-group-item-danger">
            @empleado.Apellido
            @* PREGUNTAMOS SI EXISTE EL EMPLEADO EN SESSION *@
            @if (ids == null)
            {
                <a asp-controller="Empleados" asp-action="SessionEmpleadosV5" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
            }
            else
            {
                //BUSCAMOS SI EL EMPLEADO QUE ESTAMOS RECORRIENDO ESTÁ EN LA LISTA
                if (ids.Contains(empleado.IdEmpleado))
                {
                    <img src="~/images/gtr3r.jpg" style="height:50px"/>
                }
                else
                {
                    <a asp-controller="Empleados" asp-action="SessionEmpleadosV5" asp-route-idempleado="@empleado.IdEmpleado" class="btn btn-success">Almacenar Empleado</a>
                }
            }
        </li>
    }
</ul>