@model List<Empleado>
<h1>Session salarios empleados</h1>

<p>
    <a asp-controller="Empleados" asp-action="SumaSalarial" class="btn btn-info">Mostrar Suma Salarial</a>
</p>

<h4>@ViewData["MENSAJE"]</h4>

<ul class="list-group">
    @foreach(Empleado empleado in Model)
    {
        <li class="list-group-item">
            @empleado.Apellido 
            <a asp-controller="Empleados" asp-action="SessionSalarios" asp-route-salario="@empleado.Salario" class="btn btn-success">Almacenar Salario</a>   
        </li>
    }
</ul>